// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`settings > matches the snapshot 1`] = `
"<div class="column settings">
  <h1 class="title">Settings</h1>
  <section class="settingsSection">
    <h2 class="smallFont sentenceCase mBM title">Appearance</h2>
    <div class="content">
      <div>
        <div class="mBS">
          <div class="smallFont strong mBXS title">Theme</div>
          <div class="smallFont description">Switch between dark, light, or system-preferred appearance</div>
        </div>
        <div class="badge"><label class="selectableBadge"><input class="visuallyHidden input" name="theme" type="radio"><span class="smallFont strong label">Dark</span></label><label class="selectableBadge"><input class="visuallyHidden input" name="theme" type="radio"><span class="smallFont strong label">Light</span></label><label class="selectableBadge"><input checked="" class="visuallyHidden input" name="theme" type="radio"><span class="smallFont strong label">Auto</span></label></div>
      </div>
      <div>
        <div class="mBS">
          <div class="smallFont strong mBXS title">Layout</div>
          <div class="smallFont description">Choose between a compact grid or a detailed list</div>
        </div>
        <div class="list"><label class="selectableOption"><input checked="" class="visuallyHidden input" name="layout" type="radio">
            <div class="status">
              <phcheck size="14"></phcheck>
            </div>
            <div class="details">
              <div class="smallFont strong title">Grid
                <!--v-if-->
              </div>
              <div class="smallFont description">Compact grid of items</div>
            </div>
          </label><label class="selectableOption"><input class="visuallyHidden input" name="layout" type="radio">
            <div class="status">
              <phcheck size="14"></phcheck>
            </div>
            <div class="details">
              <div class="smallFont strong title">List
                <!--v-if-->
              </div>
              <div class="smallFont description">Detailed list view</div>
            </div>
          </label></div>
      </div>
    </div>
  </section>
  <section class="settingsSection">
    <h2 class="smallFont sentenceCase mBM title">Audio Quality</h2>
    <div class="content">
      <div>
        <div class="mBS">
          <div class="smallFont strong mBXS title">Streaming</div>
          <div class="smallFont description">Adjusting audio quality enables server-side transcoding, converting to a compatible format with a lower bitrate for smoother streaming</div>
        </div>
        <div class="list"><label class="selectableOption"><input class="visuallyHidden input" name="streamBitrate" type="radio">
            <div class="status">
              <phcheck size="14"></phcheck>
            </div>
            <div class="details">
              <div class="smallFont strong title">Source
                <!--v-if-->
              </div>
              <div class="smallFont description">Direct playback of the original audio source without modifications</div>
            </div>
          </label><label class="selectableOption"><input class="visuallyHidden input" name="streamBitrate" type="radio">
            <div class="status">
              <phcheck size="14"></phcheck>
            </div>
            <div class="details">
              <div class="smallFont strong title">High <span class="badge">320 kbps</span></div>
              <div class="smallFont description">Superior sound quality, perfect for immersive listening with moderate data usage</div>
            </div>
          </label><label class="selectableOption"><input class="visuallyHidden input" name="streamBitrate" type="radio">
            <div class="status">
              <phcheck size="14"></phcheck>
            </div>
            <div class="details">
              <div class="smallFont strong title">Medium <span class="badge">256 kbps</span></div>
              <div class="smallFont description">Crisp audio with a balanced blend of quality and data efficiency</div>
            </div>
          </label><label class="selectableOption"><input checked="" class="visuallyHidden input" name="streamBitrate" type="radio">
            <div class="status">
              <phcheck size="14"></phcheck>
            </div>
            <div class="details">
              <div class="smallFont strong title">Low <span class="badge">192 kbps</span></div>
              <div class="smallFont description">Solid quality tailored for streaming with reduced bandwidth</div>
            </div>
          </label><label class="selectableOption"><input class="visuallyHidden input" name="streamBitrate" type="radio">
            <div class="status">
              <phcheck size="14"></phcheck>
            </div>
            <div class="details">
              <div class="smallFont strong title">Minimal <span class="badge">128 kbps</span></div>
              <div class="smallFont description">Essential audio quality optimized for the lowest data consumption</div>
            </div>
          </label></div>
      </div>
      <div>
        <div class="mBS">
          <div class="smallFont strong mBXS title">ReplayGain</div>
          <div class="smallFont description">Adjust playback volume to a consistent level using metadata embedded in your audio files</div>
        </div>
        <div class="badge"><label class="selectableBadge"><input checked="" class="visuallyHidden input" name="replayGain" type="radio"><span class="smallFont strong label">Off</span></label><label class="selectableBadge"><input class="visuallyHidden input" name="replayGain" type="radio"><span class="smallFont strong label">Track</span></label><label class="selectableBadge"><input class="visuallyHidden input" name="replayGain" type="radio"><span class="smallFont strong label">Album</span></label></div>
      </div>
      <div>
        <div class="mBS">
          <div class="smallFont strong mBXS title">Crossfade</div>
          <div class="smallFont description">Smoothly transition between tracks by switching early to the preloaded next track</div>
        </div>
        <div class="list">
          <div class="spaceBetween centerItems">
            <div class="info">
              <div class="sentenceCase smallFont strong title">Enable crossfade</div>
              <!--v-if-->
            </div>
            <div class="control"><label class="label"><input class="visuallyHidden input" type="checkbox"><span class="visuallyHidden">Enable crossfade</span><span class="track"></span><span class="knob"></span></label></div>
          </div>
          <div class="spaceBetween centerItems">
            <div class="info">
              <div class="sentenceCase smallFont strong title">Duration</div>
              <div class="smallFont description">Tracks shorter than the crossfade duration may not scrobble on some services</div>
            </div>
            <div class="control">
              <div class="centerAll spaceBetween crossfadeWrapper disabled"><span class="strong">3s</span>
                <div aria-disabled="true" class="inputRange disabled" style="--input-slider-height: 6px;" aria-label="Crossfade duration">
                  <div class="centerItems slider">
                    <div class="progressWrapper">
                      <div class="progress" style="width: 0px;"></div>
                      <!--v-if-->
                    </div>
                    <div class="thumb" style="left: -6px;"></div>
                    <!--v-if-->
                  </div>
                </div><span class="strong secondaryText">12s </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="settingsSection">
    <h2 class="smallFont sentenceCase mBM title">Navigation</h2>
    <div class="content">
      <div class="spaceBetween centerItems">
        <div class="info">
          <div class="sentenceCase smallFont strong title">Show podcasts</div>
          <div class="smallFont description">Display podcasts in the navigation menu</div>
        </div>
        <div class="control"><label class="label"><input checked="" class="visuallyHidden input" type="checkbox"><span class="visuallyHidden">Show podcasts</span><span class="track"></span><span class="knob"></span></label></div>
      </div>
      <div class="spaceBetween centerItems">
        <div class="info">
          <div class="sentenceCase smallFont strong title">Show radio stations</div>
          <div class="smallFont description">Display radio stations in the navigation menu</div>
        </div>
        <div class="control"><label class="label"><input checked="" class="visuallyHidden input" type="checkbox"><span class="visuallyHidden">Show radio stations</span><span class="track"></span><span class="knob"></span></label></div>
      </div>
    </div>
  </section>
  <section class="settingsSection">
    <h2 class="smallFont sentenceCase mBM title">Playback</h2>
    <div class="content">
      <div class="spaceBetween centerItems">
        <div class="info">
          <div class="sentenceCase smallFont strong title">Scrobble</div>
          <div class="smallFont description">Report plays to your Subsonic server</div>
        </div>
        <div class="control"><label class="label"><input checked="" class="visuallyHidden input" type="checkbox"><span class="visuallyHidden">Scrobble</span><span class="track"></span><span class="knob"></span></label></div>
      </div>
      <div class="spaceBetween centerItems">
        <div class="info">
          <div class="sentenceCase smallFont strong title">Delete podcast on end</div>
          <div class="smallFont description">Automatically delete a podcast episode when it finishes playing. NOTE: Enabling this option will not respect the repeat setting, and will delete the episode even if it is set to repeat.</div>
        </div>
        <div class="control"><label class="label"><input class="visuallyHidden input" type="checkbox"><span class="visuallyHidden">Delete podcast on end</span><span class="track"></span><span class="knob"></span></label></div>
      </div>
    </div>
  </section>
  <section class="settingsSection">
    <h2 class="smallFont sentenceCase mBM title">Maintenance</h2>
    <div class="content">
      <div class="spaceBetween centerItems responsive">
        <div class="info">
          <div class="sentenceCase smallFont strong title">Cache size</div>
          <div class="smallFont description">Approximate space used by cached audio, images, and other data</div>
        </div>
        <div class="control"><span class="secondaryText"></span></div>
      </div>
      <div class="spaceBetween centerItems">
        <div class="info">
          <div class="sentenceCase smallFont strong title">Clear cache</div>
          <div class="smallFont description">Remove all cached data and stored player/queue state</div>
        </div>
        <div class="control"><button class="centerItems buttonLink actionButton actionButton" draggable="false" type="button">
            <!--v-if--><span class="clamp text"> Clear </span>
          </button></div>
      </div>
      <div class="spaceBetween centerItems">
        <div class="info">
          <div class="sentenceCase smallFont strong title">Reset settings</div>
          <div class="smallFont description">Restore all settings to their factory defaults</div>
        </div>
        <div class="control"><button class="centerItems buttonLink actionButton actionButton" draggable="false" type="button">
            <!--v-if--><span class="clamp text"> Reset </span>
          </button></div>
      </div>
    </div>
  </section>
  <!--v-if-->
</div>"
`;
