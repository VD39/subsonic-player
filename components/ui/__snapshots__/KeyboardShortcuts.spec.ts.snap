// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`KeyboardShortcuts > when the isShortcutListOpened value is false > matches the snapshot 1`] = `
"<!--v-if-->
<!--v-if-->"
`;

exports[`KeyboardShortcuts > when the isShortcutListOpened value is true > matches the snapshot 1`] = `
"<div class="shortcutList slide-up-down-enter-from slide-up-down-enter-active">
  <h2 class="mBM title">Keyboard Shortcuts</h2>
  <div class="categories">
    <div class="mBM category">
      <h3 class="mBM categoryTitle">Test</h3>
      <ul class="list">
        <li class="spaceBetween item">
          <p>Description 1</p>
          <p class="visuallyHidden">Help text 1</p>
          <div class="keys" title="Help text 1"><code class="key">Any</code><code class="key">Key</code></div>
        </li>
      </ul>
    </div>
    <div class="mBM category">
      <h3 class="mBM categoryTitle">Test1</h3>
      <ul class="list">
        <li class="spaceBetween item">
          <p>Description 2</p>
          <p class="visuallyHidden">Help text 2</p>
          <div class="keys" title="Help text 2"><code class="key">Key</code></div>
        </li>
      </ul>
    </div>
  </div>
</div>
<span class="fullscreen"></span>"
`;
