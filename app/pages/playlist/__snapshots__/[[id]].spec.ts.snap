// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`[[id]] > matches the snapshot 1`] = `
"<div class="column centerAll loadingData" style="display: none;"><span class="mainLoader"><span class="headphones"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" viewBox="0 0 24 24" width="75" xmlns="http://www.w3.org/2000/svg"><path d="M4 13.5V13c0-4.97 3.582-9 8-9s8 4.03 8 9v.5"></path><path d="M2 17.439v-1.877a2 2 0 0 1 1.515-1.94L4 13.5l1.254-.314a.6.6 0 0 1 .746.582v5.464a.6.6 0 0 1-.746.582l-1.74-.435A2 2 0 0 1 2 17.439ZM22 17.439v-1.877a2 2 0 0 0-1.515-1.94L20 13.5l-1.255-.314a.6.6 0 0 0-.745.582v5.464a.6.6 0 0 0 .745.582l1.74-.435A2 2 0 0 0 22 17.439Z"></path></svg></span><span class="centerItems loader"><span class="bar"></span><span class="bar"></span><span class="bar"></span><span class="bar"></span></span><output class="visuallyHidden">Loading data</output></span></div>
<div class="mainContent">
  <div class="column centerAll noMediaMessage"><svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-playlist">
      <path d="M11 17a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path>
      <path d="M17 17v-13h4"></path>
      <path d="M13 5h-10"></path>
      <path d="M3 9l10 0"></path>
      <path d="M9 13h-6"></path>
    </svg>
    <p>No playlist found.</p>
  </div>
</div>"
`;

exports[`[[id]] > when loadPlaylistTracksById does return data > matches the snapshot 1`] = `
"<div class="column centerAll loadingData" style="display: none;"><span class="mainLoader"><span class="headphones"><svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" viewBox="0 0 24 24" width="75" xmlns="http://www.w3.org/2000/svg"><path d="M4 13.5V13c0-4.97 3.582-9 8-9s8 4.03 8 9v.5"></path><path d="M2 17.439v-1.877a2 2 0 0 1 1.515-1.94L4 13.5l1.254-.314a.6.6 0 0 1 .746.582v5.464a.6.6 0 0 1-.746.582l-1.74-.435A2 2 0 0 1 2 17.439ZM22 17.439v-1.877a2 2 0 0 0-1.515-1.94L20 13.5l-1.255-.314a.6.6 0 0 0-.745.582v5.464a.6.6 0 0 0 .745.582l1.74-.435A2 2 0 0 0 22 17.439Z"></path></svg></span><span class="centerItems loader"><span class="bar"></span><span class="bar"></span><span class="bar"></span><span class="bar"></span></span><output class="visuallyHidden">Loading data</output></span></div>
<div class="mainContent">
  <div>
    <div class="entryHeader">
      <div class="centerAll preloadImage backgroundImage"><span class="skeletonLoader"><span class="visuallyHidden">Loading image</span></span><img alt="playlist-0" class="image" draggable="false" src="image"></div>
      <div class="blur"></div>
    </div>
    <section class="mBXL content">
      <figure class="figure" draggable="true">
        <div class="centerAll preloadImage preloadImage" data-test-id="image"><span class="skeletonLoader"><span class="visuallyHidden">Loading image</span></span><img alt="playlist-0" class="image" draggable="false" src="image"></div>
      </figure>
      <div class="mBAllM detailsWrapper">
        <div class="centerItems spaceBetween">
          <h1>playlist-0</h1>
          <div class="centerItems"><button class="centerItems buttonLink" draggable="false" type="button" id="refresh-data-button" title="Refresh page data"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-refresh icon" aria-hidden="true">
                <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4"></path>
                <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"></path>
              </svg><span class="clamp text visuallyHidden">Refresh page data</span></button></div>
        </div>
        <ul class="bulletList">
          <li>Playlist</li>
          <li><span class="strong">1</span> Track</li>
          <li><span class="visuallyHidden">Duration: </span><time>00:01</time></li>
        </ul>
        <div class="list"><button class="centerItems buttonLink largeThemeHoverButton largeThemeHoverButton" draggable="false" type="button" id="play-all-button" title="Play tracks"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-player-play icon" aria-hidden="true">
              <path d="M7 4v16l13 -8l-13 -8"></path>
            </svg><span class="clamp text visuallyHidden"> Play tracks </span></button><button class="centerItems buttonLink" draggable="false" type="button" id="shuffle-all-button" title="Shuffle tracks"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-arrows-shuffle icon" aria-hidden="true">
              <path d="M18 4l3 3l-3 3"></path>
              <path d="M18 20l3 -3l-3 -3"></path>
              <path d="M3 7h3a5 5 0 0 1 5 5a5 5 0 0 0 5 5h5"></path>
              <path d="M21 7h-5a4.978 4.978 0 0 0 -3 1m-4 8a4.984 4.984 0 0 1 -3 1h-3"></path>
            </svg><span class="clamp text visuallyHidden"> Shuffle tracks </span></button>
          <div class="centerItems dropdownWrapper"><button class="centerItems buttonLink alignRight buttonLink buttonLink" draggable="false" type="button" aria-expanded="true" aria-haspopup="menu" title="More"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-dots-vertical icon" aria-hidden="true">
                <path d="M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
                <path d="M11 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
                <path d="M11 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"></path>
              </svg><span class="clamp text visuallyHidden"> More</span></button>
            <teleport-stub disabled="false" to="#teleports">
              <div class="dropdownOverlay backdrop dropdown">
                <ul class="hasPointerEvents dropdownContent dropdownContent">
                  <li class="centerItems dropdownItem"><button class="centerItems buttonLink centerAll fullWidth spaceBetween item spaceBetween item" draggable="false" type="button">
                      <!--v-if--><span class="clamp text"> Edit Playlist </span>
                    </button></li>
                  <li class="centerItems dropdownItem"><button class="centerItems buttonLink centerAll fullWidth spaceBetween item spaceBetween item" draggable="false" type="button">
                      <!--v-if--><span class="clamp text"> Delete Playlist </span>
                    </button></li>
                  <li aria-hidden="true" class="divider"></li>
                  <li class="centerItems dropdownItem"><button class="centerItems buttonLink centerAll fullWidth spaceBetween item spaceBetween item" draggable="false" type="button">
                      <!--v-if--><span class="clamp text"> Add to queue </span>
                    </button></li>
                  <li class="centerItems dropdownItem"><button class="centerItems buttonLink centerAll fullWidth spaceBetween item spaceBetween item" draggable="false" type="button">
                      <!--v-if--><span class="clamp text"> Play Tracks </span>
                    </button></li>
                </ul>
              </div>
            </teleport-stub>
          </div>
        </div>
      </div>
    </section>
    <tracklist-mixed-stub tracks="[object Object]"></tracklist-mixed-stub>
  </div>
</div>"
`;

