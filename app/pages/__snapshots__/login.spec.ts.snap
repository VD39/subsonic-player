// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`login > matches the snapshot 1`] = `
"<div class="mBAllM inner login">
  <div class="centerItems spaceBetween">
    <h1>Login</h1>
    <div class="centerItems"><button class="centerItems buttonLink" draggable="false" type="button" title="Activate dark mode"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-moon icon" aria-hidden="true">
          <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454l0 .008"></path>
        </svg><span class="clamp text visuallyHidden">Activate dark mode</span></button></div>
  </div>
  <form novalidate="">
    <div class="formFields">
      <div class="mBM">
        <div class="mBS">
          <div class="smallFont strong mBXS title">Login method</div>
          <!--v-if-->
        </div>
        <div class="badge"><label class="selectableBadge"><input checked="" class="visuallyHidden input" name="loginMode" type="radio"><span class="smallFont strong label">Password</span></label><label class="selectableBadge"><input class="visuallyHidden input" name="loginMode" type="radio"><span class="smallFont strong label">API key</span></label></div>
      </div>
      <div class="column inputField formField"><label class="mBXS sentenceCase smallFont label" for="server">server <span class="required">*</span></label><input id="server" autocomplete="off" class="interactionInput input formField" placeholder="Enter your server URL" required="" type="text">
        <!--v-if-->
      </div>
      <div class="column inputField formField"><label class="mBXS sentenceCase smallFont label" for="username">username <span class="required">*</span></label><input id="username" autocomplete="off" class="interactionInput input formField" placeholder="Enter your username" required="" type="text">
        <!--v-if-->
      </div>
      <div class="column inputField formField"><label class="mBXS sentenceCase smallFont label" for="password">password <span class="required">*</span></label><input id="password" autocomplete="off" class="interactionInput input formField" placeholder="Enter your password" required="" type="password">
        <!--v-if-->
      </div>
      <div class="spaceBetween centerItems">
        <div class="info">
          <div class="sentenceCase smallFont strong title">Legacy authentication</div>
          <div class="smallFont description">Send the password hex-encoded instead of as a salted token.</div>
        </div>
        <div class="control"><label class="label"><input class="visuallyHidden input" type="checkbox"><span class="visuallyHidden">Legacy authentication</span><span class="track"></span><span class="knob"></span></label></div>
      </div>
    </div>
    <!--v-if--><button class="centerItems buttonLink centerAll fullWidth actionButton formButton actionButton formButton" draggable="false" type="submit">
      <!--v-if--><span class="clamp text"> Login </span>
    </button>
  </form>
</div>"
`;
