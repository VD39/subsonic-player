      <figure class="imageLink"><a class="interactionWrapperLink" draggable="false" title="Go to playlist playlist-0">
          <div class="centerAll preloadImage">
            <div class="iconImage">
              <iconplaylist fill="none" strokewidth="1" class="icon"></iconplaylist>
            </div>
          </div>
        </a></figure>
      <div class="spaceBetween">
        <div>
          <h4 class="mBS"><a aria-label="Go to playlist playlist-0" class="link" draggable="false">playlist-0</a></h4>
          <ul class="bulletList smallFont">
            <li>1 tracks</li>
            <li><time>00:01</time></li>
          </ul>
        </div>
        <div class="centerItems dropdownWrapper"><button class="centerItems buttonLink alignRight buttonLink buttonLink" draggable="false" type="button" aria-expanded="false" aria-haspopup="menu" title="More">
            <icondotsvertical fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></icondotsvertical><span class="clamp text visuallyHidden"> More</span>
          </button>
          <teleport-stub disabled="false" to="#teleports">
