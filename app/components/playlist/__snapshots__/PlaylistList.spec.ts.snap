// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PlaylistList > matches the snapshot 1`] = `
"<div class="column centerAll noMediaMessage">
  <iconplaylist fill="none" size="50" strokewidth="1"></iconplaylist>
  <p>No playlists found.</p>
</div>"
`;

exports[`PlaylistList > when the playlists prop is not an empty array > matches the snapshot 1`] = `
"<section class="mediaListWrapper" style="--loop-rows-mobile: 1; --loop-rows-tablet: 2; --loop-rows-desktop: 2; --loop-grid-gap: 24px;">
