// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FavouriteButton > when favouriteIds id key is false > matches the snapshot 1`] = `
"<button class="centerItems buttonLink alignRight" draggable="false" type="button" title="Like album">
  <iconheart fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconheart><span class="clamp text visuallyHidden">Like album</span>
</button>"
`;

exports[`FavouriteButton > when favouriteIds id key is true > matches the snapshot 1`] = `
"<button class="centerItems buttonLink alignRight" draggable="false" type="button" title="Unlike album">
  <iconheart color="var(--error-color)" fill="var(--error-color)" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconheart><span class="clamp text visuallyHidden">Unlike album</span>
</button>"
`;
