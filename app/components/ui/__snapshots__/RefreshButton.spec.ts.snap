// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RefreshButton > when status prop is error > matches the snapshot 1`] = `
"<button class="centerItems buttonLink" draggable="false" type="button" id="refresh-data-button" title="Refresh page data">
  <iconrefresh fill="none" size="32" strokewidth="1" aria-hidden="true" class="icon"></iconrefresh><span class="clamp text visuallyHidden">Refresh page data</span>
</button>"
`;

exports[`RefreshButton > when status prop is idle > matches the snapshot 1`] = `
"<button class="centerItems buttonLink" draggable="false" type="button" id="refresh-data-button" title="Refresh page data">
  <iconrefresh fill="none" size="32" strokewidth="1" aria-hidden="true" class="icon"></iconrefresh><span class="clamp text visuallyHidden">Refresh page data</span>
</button>"
`;

exports[`RefreshButton > when status prop is pending > matches the snapshot 1`] = `"<button class="centerItems buttonLink" draggable="false" type="button" id="refresh-data-button" title="Refreshing page data"><span class="centerItems spinningLoader icon" fill="none" strokewidth="1" aria-hidden="true"><iconloader2 fill="none" size="32" strokewidth="1" class="icon"></iconloader2><span class="visuallyHidden">Loading...</span></span><span class="clamp text visuallyHidden">Refreshing page data</span></button>"`;

exports[`RefreshButton > when status prop is success > matches the snapshot 1`] = `
"<button class="centerItems buttonLink" draggable="false" type="button" id="refresh-data-button" title="Refresh page data">
  <iconrefresh fill="none" size="32" strokewidth="1" aria-hidden="true" class="icon"></iconrefresh><span class="clamp text visuallyHidden">Refresh page data</span>
</button>"
`;
