// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PlayerControls > matches the snapshot 1`] = `
"<div class="centerItems playerControls"><button class="centerItems buttonLink" draggable="false" type="button" title="Switch shuffle on">
    <iconarrowsshuffle color="currentColor" fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconarrowsshuffle><span class="clamp text visuallyHidden">Switch shuffle on</span>
  </button>
  <div class="centerItems spaceBetween"><button class="centerItems buttonLink disabled" disabled="" draggable="false" type="button" title="Previous track">
      <iconplayerskipback fill="currentColor" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerskipback><span class="clamp text visuallyHidden"> Previous track </span>
    </button>
    <!--v-if--><button class="centerItems buttonLink playPauseButton playPauseButton" draggable="false" type="button" title="Play current track">
      <iconplayerplay fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerplay><span class="clamp text visuallyHidden">Play current track</span>
    </button>
    <!--v-if--><button class="centerItems buttonLink disabled" disabled="" draggable="false" type="button" title="Next track">
      <iconplayerskipforward fill="currentColor" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerskipforward><span class="clamp text visuallyHidden"> Next track </span>
    </button>
  </div><button class="centerItems buttonLink" draggable="false" type="button" title="Turn on repeat all">
    <iconrepeat color="currentColor" fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconrepeat><span class="clamp text visuallyHidden">Turn on repeat all</span>
  </button>
</div>"
`;

exports[`PlayerControls > when the isRadioStation value is true > matches the snapshot 1`] = `
"<div class="centerItems playerControls">
  <!--v-if-->
  <div class="centerItems spaceBetween"><button class="centerItems buttonLink disabled" disabled="" draggable="false" type="button" title="Previous track">
      <iconplayerskipback fill="currentColor" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerskipback><span class="clamp text visuallyHidden"> Previous track </span>
    </button>
    <!--v-if--><button class="centerItems buttonLink playPauseButton playPauseButton" draggable="false" type="button" title="Play current track">
      <iconplayerplay fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerplay><span class="clamp text visuallyHidden">Play current track</span>
    </button>
    <!--v-if--><button class="centerItems buttonLink disabled" disabled="" draggable="false" type="button" title="Next track">
      <iconplayerskipforward fill="currentColor" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerskipforward><span class="clamp text visuallyHidden"> Next track </span>
    </button>
  </div>
  <!--v-if-->
</div>"
`;
