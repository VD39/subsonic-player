// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MainPlayerControls > matches the snapshot 1`] = `
"<div class="centerItems spaceBetween"><button class="centerItems buttonLink" draggable="false" type="button" title="Previous track">
    <iconplayerskipback fill="currentColor" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerskipback><span class="clamp text visuallyHidden"> Previous track </span>
  </button>
  <!--v-if--><button class="centerItems buttonLink playPauseButton playPauseButton" draggable="false" type="button" title="Play current track">
    <iconplayerplay fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerplay><span class="clamp text visuallyHidden">Play current track</span>
  </button>
  <!--v-if--><button class="centerItems buttonLink" draggable="false" type="button" title="Next track">
    <iconplayerskipforward fill="currentColor" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerskipforward><span class="clamp text visuallyHidden"> Next track </span>
  </button>
</div>"
`;

exports[`MainPlayerControls > when the isPodcastEpisode value is true > matches the snapshot 1`] = `
"<div class="centerItems spaceBetween"><button class="centerItems buttonLink" draggable="false" type="button" title="Previous track">
    <iconplayerskipback fill="currentColor" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerskipback><span class="clamp text visuallyHidden"> Previous track </span>
  </button><button class="centerItems buttonLink" draggable="false" type="button" title="Rewind back 10 seconds">
    <iconrewindbackward10 fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconrewindbackward10><span class="clamp text visuallyHidden">Rewind back 10 seconds</span>
  </button><button class="centerItems buttonLink playPauseButton playPauseButton" draggable="false" type="button" title="Play current track">
    <iconplayerplay fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerplay><span class="clamp text visuallyHidden">Play current track</span>
  </button><button class="centerItems buttonLink" draggable="false" type="button" title="Fast forward 30 seconds">
    <iconrewindforward30 fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconrewindforward30><span class="clamp text visuallyHidden">Fast forward 30 seconds</span>
  </button><button class="centerItems buttonLink" draggable="false" type="button" title="Next track">
    <iconplayerskipforward fill="currentColor" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerskipforward><span class="clamp text visuallyHidden"> Next track </span>
  </button></div>"
`;
