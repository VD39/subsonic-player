exports[`PlayPauseButton > when the isBuffering value is false > when the shuffle value is set to false > matches the snapshot 1`] = `
"<button class="centerItems buttonLink" draggable="false" type="button" title="Play current track">
  <iconplayerplay fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerplay><span class="clamp text visuallyHidden">Play current track</span>
</button>"
`;

exports[`PlayPauseButton > when the isBuffering value is false > when the shuffle value is set to true > matches the snapshot 1`] = `
"<button class="centerItems buttonLink" draggable="false" type="button" title="Pause current track">
  <iconplayerpause fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerpause><span class="clamp text visuallyHidden">Pause current track</span>
</button>"
`;

exports[`PlayPauseButton > when the isBuffering value is true > matches the snapshot 1`] = `"<span class="centerItems spinningLoader spinningLoader"><iconloader2 fill="none" size="24" strokewidth="1" class="icon"></iconloader2><span class="visuallyHidden">Loading...</span></span>"`;
