// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ShuffleButton > when shuffle is set to false > matches the snapshot 1`] = `
"<button class="centerItems buttonLink" draggable="false" type="button" title="Switch shuffle on">
  <iconarrowsshuffle color="currentColor" fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconarrowsshuffle><span class="clamp text visuallyHidden">Switch shuffle on</span>
</button>"
`;

exports[`ShuffleButton > when shuffle is set to true > matches the snapshot 1`] = `
"<button class="centerItems buttonLink" draggable="false" type="button" title="Switch shuffle off">
  <iconarrowsshuffle color="var(--theme-color)" fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconarrowsshuffle><span class="clamp text visuallyHidden">Switch shuffle off</span>
</button>"
`;
