// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RepeatButton > when shuffle is set to -1 > matches the snapshot 1`] = `
"<button class="centerItems buttonLink" draggable="false" type="button" title="Turn on repeat all">
  <iconrepeat color="currentColor" fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconrepeat><span class="clamp text visuallyHidden">Turn on repeat all</span>
</button>"
`;

exports[`RepeatButton > when shuffle is set to 1 > matches the snapshot 1`] = `
"<button class="centerItems buttonLink" draggable="false" type="button" title="Turn repeat off">
  <iconrepeatonce color="var(--theme-color)" fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconrepeatonce><span class="clamp text visuallyHidden">Turn repeat off</span>
</button>"
`;

exports[`RepeatButton > when shuffle is set to Infinity > matches the snapshot 1`] = `
"<button class="centerItems buttonLink" draggable="false" type="button" title="Turn on repeat one">
  <iconrepeat color="var(--theme-color)" fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconrepeat><span class="clamp text visuallyHidden">Turn on repeat one</span>
</button>"
`;
