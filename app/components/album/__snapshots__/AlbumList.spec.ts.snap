exports[`AlbumList > when the albums prop is not an empty array > matches the snapshot 1`] = `
"<section class="mediaListWrapper" style="--loop-rows-mobile: 2; --loop-rows-tablet: 3; --loop-rows-desktop: 5; --loop-grid-gap: 24px;">
  <article class="interactionWrapper layoutItem" draggable="false">
    <div class="layoutImage layoutItemImageWrapper">
      <figure><a class="interactionWrapperLink" draggable="false" title="Go to album album-0">
          <div class="centerAll preloadImage"><span class="skeletonLoader"><span class="visuallyHidden">Loading image</span></span><img alt="Go to album album-0" class="image" draggable="false" src="image"></div>
        </a></figure>
      <div class="hideOnListLayout layoutItemActions layoutItemHoverActions">
        <div class="centerItems actionsLeft"><button class="centerItems buttonLink themeHoverButton themeHoverButton" draggable="false" type="button" title="Play album album-0">
            <iconplayerplay fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplayerplay><span class="clamp text visuallyHidden">Play album album-0</span>
          </button><button class="centerItems buttonLink" draggable="false" type="button" title="Add album to queue">
            <iconcircleplus fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconcircleplus><span class="clamp text visuallyHidden"> Add album to queue </span>
          </button></div><button class="centerItems buttonLink alignRight" draggable="false" type="button" title="Unlike album">
          <iconheart color="var(--error-color)" fill="var(--error-color)" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconheart><span class="clamp text visuallyHidden">Unlike album</span>
        </button>
      </div>
    </div>
    <div class="layoutContent">
      <p class="mBXS strong smallFont clamp2"><a aria-label="Go to album album-0" class="layoutLink" draggable="false">album-0</a></p>
      <ul class="commaList smallFont clamp2">
        <li data-test-id="artist-list-item"><a aria-label="Go to artist name" class="link">name</a></li>
        <li data-test-id="artist-list-item"><a aria-label="Go to artist name1" class="link">name1</a></li>
      </ul>
    </div>
    <div class="layoutDropdownMenu layoutItemHoverActions">
      <div class="centerItems dropdownWrapper"><button class="centerItems buttonLink alignRight buttonLink buttonLink" draggable="false" type="button" aria-expanded="false" aria-haspopup="menu" title="More">
