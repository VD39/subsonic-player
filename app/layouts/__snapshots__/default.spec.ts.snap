exports[`DefaultLayout > matches the snapshot 1`] = `
"<div class="mainLayout">
  <header class="centerItems header">
    <div class="spaceBetween inner centerItems"><a class="centerItems buttonLink mobileOnly mobileOnly" draggable="false" title="Home">
        <iconwaveform fill="none" size="32" strokewidth="1" aria-hidden="true" class="icon"></iconwaveform><span class="clamp text visuallyHidden"> Home </span>
      </a>
      <div class="search">
        <div class="searchForm">
          <form novalidate="">
            <div class="centerItems">
              <div class="column inputField inputField"><label class="mBXS sentenceCase smallFont label visuallyHidden" for="search-input">query <span class="required">*</span></label><input id="search-input" autocomplete="off" class="interactionInput input inputField" placeholder="Enter query" required="" type="text">
                <!--v-if-->
              </div><button class="centerItems buttonLink buttonLink buttonLink" draggable="false" type="submit" title="Search">
                <iconsearch fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconsearch><span class="clamp text visuallyHidden">Search</span>
              </button>
            </div>
          </form>
          <!--v-if-->
          <!--v-if-->
        </div>
      </div>
      <div class="centerItems secondary">
        <user-menu-stub></user-menu-stub>
      </div>
    </div>
  </header>
  <aside aria-label="Sidebar">
    <div class="centerItems column sidebarNavigation desktopOnly">
      <div class="mBM centerAll spaceBetween header"><a class="centerItems buttonLink musicLogo musicLogo" draggable="false" title="Home">
          <iconwaveform fill="none" size="32" strokewidth="1" aria-hidden="true" class="icon"></iconwaveform><span class="clamp text visuallyHidden"> Home </span>
        </a><button class="centerItems buttonLink" draggable="false" type="button" title="Close Navigation">
          <iconlayoutsidebarleftcollapse fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconlayoutsidebarleftcollapse><span class="clamp text visuallyHidden">Close Navigation</span>
        </button></div>
      <nav aria-label="Primary" class="fullWidth">
        <ul class="mBM">
          <li class="mBM">
            <p class="strong mBM sidebarTitle">Browse</p>
            <ul>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Discover">
                  <iconcompass fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconcompass><span class="clamp text">Discover</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Podcasts">
                  <iconbrandapplepodcast fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconbrandapplepodcast><span class="clamp text">Podcasts</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Radio Stations">
                  <iconradio fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconradio><span class="clamp text">Radio Stations</span>
                </a></li>
              <li class="isDroppable"><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Queue">
                  <iconlistdetails fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconlistdetails><span class="clamp text">Queue</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Bookmarks">
                  <iconbookmark fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconbookmark><span class="clamp text">Bookmarks</span>
                </a></li>
            </ul>
          </li>
          <li class="mBM">
            <p class="strong mBM sidebarTitle">Your library</p>
            <ul>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Albums">
                  <icondisc fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></icondisc><span class="clamp text">Albums</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Artists">
                  <iconusers fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconusers><span class="clamp text">Artists</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Playlists">
                  <iconplaylist fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplaylist><span class="clamp text">Playlists</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Favourites">
                  <iconheart fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconheart><span class="clamp text">Favourites</span>
                </a></li>
              <li class=""><a exactactiveclass="sidebarCurrentLink" class="centerItems buttonLink sidebarLink sidebarLink" draggable="false" title="Genres">
                  <iconwaveform fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconwaveform><span class="clamp text">Genres</span>
                </a></li>
            </ul>
          </li>
        </ul>
        <ul class="mBM">
          <li>
            <p class="strong mBM sidebarTitle">Playlist</p>
            <ul></ul>
          </li>
          <li><button class="centerItems buttonLink centerAll fullWidth sidebarLink sidebarLink" draggable="false" type="button" title="Add playlist">
              <iconplaylistadd fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplaylistadd><span class="clamp text"> Add playlist </span>
            </button></li>
        </ul>
      </nav>
    </div>
    <nav aria-label="Mobile" class="mobileOnly">
      <ul class="inner centerAll spaceBetween mobileNavigation">
        <li class="item"><a class="centerItems buttonLink link smallFont column centerAll link smallFont column centerAll" draggable="false" title="Browse">
            <iconcompass fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconcompass><span class="clamp text">Browse</span>
          </a></li>
        <li class="item"><a class="centerItems buttonLink link smallFont column centerAll link smallFont column centerAll" draggable="false" title="Your library">
            <iconmusic fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconmusic><span class="clamp text">Your library</span>
          </a></li>
        <li class="item"><a class="centerItems buttonLink link smallFont column centerAll link smallFont column centerAll" draggable="false" title="Playlists">
            <iconplaylist fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconplaylist><span class="clamp text">Playlists</span>
          </a></li>
        <li class="item"><a class="centerItems buttonLink link smallFont column centerAll link smallFont column centerAll" draggable="false" title="Bookmarks">
            <iconbookmark fill="none" size="24" strokewidth="1" aria-hidden="true" class="icon"></iconbookmark><span class="clamp text">Bookmarks</span>
          </a></li>
      </ul>
    </nav>
  </aside>
  <main class="main mainContent" tabindex="-1">
    <div class="column mainContentInner">
      <!--v-if-->
      <div class="column inner mBAllL">Default slot content.</div>
    </div>
  </main>
  <div>
    <music-player-and-queue-stub></music-player-and-queue-stub>
  </div>
</div>"
`;

